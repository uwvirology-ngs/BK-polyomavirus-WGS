/* 
 * Parameters
 */
params {
    // core
    input	      = null
	output		  = "results"
	provide_ref   = false
	ref 		  = null

    // revica-strm
	db 			  = "${projectDir}/assets/references/bkv_multi.fa"
	ref_min_depth = 3
    ref_min_cov   = 30
}

/*
 * Process Directives
 */
process {

	// TWIST 

	withLabel: 'twist' {
		container = 'community.wave.seqera.io/library/bwa_fgbio_picard_samtools_seqtk:02c14c4891e4715e'
	}

	// REVICA

	withName: 'REFERENCE_PREP:BWA_MEM_ALIGN_DB' {
        ext.args = 'local=true maxindel=80 ambiguous=all'
        publishDir = [
            path: { "results/revica/align_to_db/pass" }, 
            mode: 'copy',
            pattern: "*covstats.tsv",
        ]
	}

	withName: 'REFERENCE_PREP:SELECT_REFERENCE' {
		ext.args = { "-m ${params.ref_min_depth} -p ${params.ref_min_cov}" }
		publishDir = [
			path: { "results/revica/align_to_db/fail" },
			mode: 'copy',
			pattern: "*_failed_assembly.tsv"
		]
	}

	withName: 'REFERENCE_PREP:MAKE_REFERENCE_FASTA' {
		ext.prefix = { "${meta.id}_${ref_info.acc}" }
		publishDir = [
			path: { "results/revica/make_reference_fasta" },
			mode: 'copy',
		    pattern: "*.fa"
        ]
	}
}

/*
 * Output Settings
 */
outputDir = params.output

profiles {
    toaster {
        process.executor = 'local'
    }
    awsbatch {
		executor.queueSize = 5
		process {
			executor = 'awsbatch'
			errorStrategy = 'retry'
			maxRetries = 1

			resourceLimits = [
				memory: 64.GB,
				cpus: 32,
				time: 2.d
        	]

			cpus   = 4
			memory = 8.GB
			time   = 4.h

			withLabel:process_single {
                cpus   = 1
                memory = 2.GB
                time   = 2.h
            }
            withLabel:process_low {
                cpus   = 2
                memory = 3.GB
                time   = 4.h
            }
            withLabel:process_medium {
                cpus   = 4
                memory = 6.GB
                time   = 6.h
            }
            withLabel:process_high {
                cpus   = 6
                memory = 12.GB
                time   = 8.h
            }
		}
    }
}

docker.enabled = true