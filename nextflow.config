/* 
 * Parameters
 */
params {
    input	      = null
	output		  = null
	ref 		  = null

    // reference selection
	db 			  = "${projectDir}/assets/database/bkv_multi.fa"
	ref_min_depth = 3
    ref_min_cov   = 30

	// Thresholds for alignment to initial consensus
	cons_init_min_depth = 5
	cons_init_min_cov = 60

	ivar_init_t = 0.6
	ivar_init_q = 20
	ivar_init_m = 1

	ivar_fin_t = 0.4
	ivar_fin_q = 20
	ivar_fin_m = 3

	// set by profile
	cloud_compute = false
}

/*
 * Process Directives
 */
process {

	// TWIST 
	withLabel: 'twist' {
		container = 'community.wave.seqera.io/library/bwa_fgbio_picard_samtools_seqtk:02c14c4891e4715e'
	}

	// REVICA - reference prep
	withName: 'REFERENCE_PREP:BWA_MEM_ALIGN_DB' {
        ext.args = 'local=true maxindel=80 ambiguous=all'
        publishDir = [
            path: { "${params.output}/reference_prep/align_to_db/pass" }, 
            mode: 'copy',
            pattern: "*covstats.tsv",
        ]
	}
	withName: 'REFERENCE_PREP:SELECT_REFERENCE' {
		ext.args = { "-m ${params.ref_min_depth} -p ${params.ref_min_cov}" }
		publishDir = [
			path: { "${params.output}/reference_prep/align_to_db/fail" },
			mode: 'copy',
			pattern: "*_failed_assembly.tsv"
		]
	}
	withName: 'REFERENCE_PREP:MAKE_REFERENCE_FASTA' {
		ext.prefix = { "${meta.id}_${ref_info.acc}" }
		publishDir = [
			path: { "${params.output}/reference_prep/make_reference_fasta" },
			mode: 'copy',
		    pattern: "*.fa"
        ]
	}

	// REVICA - consensus assembly
	withName: 'CONSENSUS_ASSEMBLY:BWA_MEM_ALIGN_QUERY' {
		ext.args = 'local=true ambiguous=random'	
		ext.min_coverage = {"${params.ref_min_cov}"}
		ext.min_depth = {"${params.ref_min_depth}"}
		ext.iter = "ref"
		ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_ref" }
		publishDir = [
			[
				path: { "${params.output}/consensus_assembly/align_to_selected_ref" },
				mode: 'copy',
				pattern: "*.{bam,bai}"
			],
			[
				path: { "${params.output}/consensus_assembly/fail/align_to_reference" },
				mode: 'copy',
				pattern: "*_failed_assembly.tsv"
			]
		]
	}
	withName: '.*:IVAR_CONSENSUS_BWA_MEM_ALIGN_INITIAL_ASSEMBLY:IVAR_CONSENSUS' {
		ext.args = { "-t ${params.ivar_init_t} -q ${params.ivar_init_q} -m ${params.ivar_init_m} -n N" }
		ext.args2 = '--count-orphans --no-BAQ --max-depth 0 --min-BQ 0 -aa'
		ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_consensus1" }
		publishDir = [ 
			path: { "${params.output}/consensus_assembly/align_to_consensus" },
			mode: 'copy',
			pattern: "*.fa"
		]
	}
	withName: '.*:IVAR_CONSENSUS_BWA_MEM_ALIGN_INITIAL_ASSEMBLY:BWA_MEM_ALIGN' {
		ext.args = 'local=true ambiguous=random'
		ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_consensus1" }
		ext.iter = "con1"
		ext.min_coverage = {"${params.cons_init_min_cov}"}
		ext.min_depth = {"${params.cons_init_min_depth}"}
		publishDir = [
			[
				path: { "${params.output}/consensus_assembly/align_to_consensus" },
				mode: 'copy',
				pattern: "*.{bam,bai}",
			],
			[
				path: { "${params.output}/consensus_assembly/fail/align_to_consensus" },
				mode: 'copy',
				pattern: "*_failed_assembly.tsv"
			]
		]
	}
	withName: 'CONSENSUS_ASSEMBLY:BUILD_FINAL_CONSENSUS' {
		ext.args = { "-t ${params.ivar_fin_t} -q ${params.ivar_fin_q} -m ${params.ivar_fin_m} -n N" }
		ext.args2 = '--count-orphans --no-BAQ --max-depth 0 --min-BQ 0 -aa'
		ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_consensus_final" }
		publishDir = [ 
			path: { "${params.output}/consensus_assembly/final_assemblies" },
			mode: 'copy',
			pattern: "*.fa"
		]
	}
}

/*
 * Output Settings
 */
outputDir = params.output

/*
 * Execution Profiles
 */
profiles {

	// local development
    toaster {
        process {
			executor = 'local'
			
			resourceLimits = [
				memory: 8.GB,
				cpus: 6,
				time: 2.h
			]
		}
    }

	// cloud computing
    awsbatch {
		params {
			cloud_compute = true
		}
		process {
			executor = 'awsbatch'

			resourceLimits = [
				memory: 64.GB,
				cpus: 32,
				time: 2.d
        	]

			errorStrategy = 'retry'
			maxRetries = 2

			withLabel:process_single {
                cpus   = 1
                memory = { 2.GB * task.attempt }
                time   = 1.h
            }
            withLabel:process_low {
                cpus   = 2
                memory = { 4.GB * task.attempt }
                time   = 2.h
            }
            withLabel:process_medium {
                cpus   = 4
                memory = { 6.GB * task.attempt }
                time   = 3.h
            }
            withLabel:process_high {
                cpus   = 8
                memory = { 8.GB * task.attempt }
                time   = 4.h
            }
		}
		report {
			overwrite = true
		}
		
		//fusion.enabled = true
		//wave.enabled = true
    }
}

docker.enabled = true