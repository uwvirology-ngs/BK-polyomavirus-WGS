/* 
 * Parameters
 */
params {
    input	      = null
	output		  = null
	db 			  = "${projectDir}/assets/database/bkv_multi.fa"
	ref 		  = null
	labName 	  = null

	// Minimum number of mapped reads for downstream processes
	min_mapped_reads = 1000

	ivar_variants_t = 0.01
	ivar_variants_q = 20
	ivar_variants_m = 10
	save_mpileup = false

	// set by profile
	cloud_compute = false
}

/*
 * Process Directives
 */
process {
	withLabel: 'twist' {
		container = 'community.wave.seqera.io/library/bwa_fgbio_picard_samtools_seqtk:02c14c4891e4715e'
	}
}

/*
 * Output Settings
 */
outputDir = params.output

/*
 * Execution Profiles
 */
profiles {

	// local development
    toaster {
        process {
			executor = 'local'
			
			resourceLimits = [
				memory: 8.GB,
				cpus: 6,
				time: 2.h
			]
		}
    }

	// cloud computing
    awsbatch {
		params {
			cloud_compute = true
		}
		process {
			executor = 'awsbatch'

			resourceLimits = [
				memory: 64.GB,
				cpus: 32,
				time: 2.d
        	]

			errorStrategy = 'retry'
			maxRetries = 2

			withLabel:process_single {
                cpus   = 1
                memory = { 2.GB * task.attempt }
                time   = 1.h
            }
            withLabel:process_low {
                cpus   = 2
                memory = { 4.GB * task.attempt }
                time   = 2.h
            }
            withLabel:process_medium {
                cpus   = 4
                memory = { 6.GB * task.attempt }
                time   = 3.h
            }
            withLabel:process_high {
                cpus   = 8
                memory = { 8.GB * task.attempt }
                time   = 4.h
            }
		}
		report {
			overwrite = true
		}

		includeConfig "${projectDir}/conf/batch.config"
    }
}

/*
 * Container Settings
 */
docker {
	enabled = true
}

/*
 * Additional Configuration
 */
includeConfig "${projectDir}/conf/refvar.config"
includeConfig "${projectDir}/conf/revica.config"