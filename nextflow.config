/* 
 * Required Parameters
 */
params {
    input 	= null
	output 	= null
}

/*
 * Optional Parameters
 */
params {

	// multifasta database of reference genomes. default: BK Polyomavirus 
	db 			= "${projectDir}/assets/database/bkv_multi.fa"

	// maximum reads per fastq after downsampling
	sampleTo 	= 1000000

	// minimum number of mapped reads for downstream processes
	min_mapped_reads = 1000

	// settings for ivar variants and preceeding mpileup
	save_mpileup  	= true
	ivar_variants_t = 0.01
	ivar_variants_q = 20
	ivar_variants_m = 10

	// set by profile
	cloud_compute = false

    // reference selection
	ref_min_depth = 10
    ref_min_cov   = 85

	// fgbio - consensus sequence settings
	fgbio_consensus_min_reads = "2 0 0"

	// ivar consensus
	ivar_consensus_ini_t = 0.6
	ivar_consensus_ini_q = 20
	ivar_consensus_ini_m = 1

	ivar_consensus_fin_t = 0.4
	ivar_consensus_fin_q = 20
	ivar_consensus_fin_m = 3
}

/*
 * Process Directives
 */
process {
	withLabel: 'twist' {
		container = 'community.wave.seqera.io/library/bwa_fgbio_picard_samtools_seqtk:02c14c4891e4715e'
	}
	withLabel: 'reference_prep' {
		container = 'aidantshea/revica:latest'
	}
	stageInMode = 'copy'

	errorStrategy = 'retry'
	maxRetries = 2
}

/*
 * Output Settings
 */
outputDir = params.output

/*
 * Container Settings
 */
docker {
	enabled = true
}

/*
 * Additional Configuration
 */
includeConfig "${projectDir}/conf/profiles.config"
